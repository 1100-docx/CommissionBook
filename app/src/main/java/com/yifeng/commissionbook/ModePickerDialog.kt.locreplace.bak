/**
 * 首启那一问：**你是买家还是画师**（2026-09-30 加）。
 *
 * 时机：隐私政策读完、该要的权限要完、人也没被锁屏拦着 —— 才浮上来这一层。
 * 只问一次（选完 / 点「稍后再说」都算问过），以后在「设置 → 使用模式」里改。
 *
 * 长得像个系统弹窗，但是自己画的 —— 两行字的选项、按下去会轻微缩一下，
 * 底色淡入 + 卡片轻微放大，不硬切（同一个工程里的老规矩）。
 */
@Composable
fun ModePickerDialog(
    onPick: (AppMode) -> Unit,
    onLater: () -> Unit,
) {
    val cs = MaterialTheme.colorScheme
    val dark = isDarkUi()
    val haptic = LocalHapticFeedback.current
    val shape = RoundedCornerShape(28.dp)

    // 出场：① 底色淡入 ② 卡片从 0.93 倍放大到 1（带一点点回弹）
    var shown by remember { mutableStateOf(false) }
    LaunchedEffect(Unit) { shown = true }
    val fade by animateFloatAsState(
        targetValue = if (shown) 1f else 0f,
        animationSpec = tween(200),
        label = "fade",
    )
    val pop by animateFloatAsState(
        targetValue = if (shown) 1f else 0.93f,
        animationSpec = spring(dampingRatio = 0.78f, stiffness = 520f),
        label = "pop",
    )

    Dialog(
        // 点旁边空白 / 按返回 = 「稍后再说」—— 不硬拦人
        onDismissRequest = onLater,
        properties = DialogProperties(usePlatformDefaultWidth = false),
    ) {
        Box(
            Modifier
                .fillMaxSize()
                .background(Color.Black.copy(alpha = 0.34f * fade)),
            contentAlignment = Alignment.Center,
        ) {
            Column(
                Modifier
                    .padding(horizontal = 28.dp)
                    .fillMaxWidth()
                    .graphicsLayer {
                        scaleX = pop
                        scaleY = pop
                        alpha = fade
                    }
                    .shadow(
                        elevation = 26.dp,
                        shape = shape,
                        clip = false,
                        ambientColor = Color(0x1F1B3A5E),
                        spotColor = Color(0x33213C5E),
                    )
                    .clip(shape)
                    .background(cs.surface)
                    // 顶边一道极淡高光：跟底栏那枚胶囊一个手法，不再像一块塑料贴片
                    .border(
                        width = 1.dp,
                        brush = Brush.verticalGradient(
                            listOf(
                                Color.White.copy(alpha = if (dark) 0.10f else 0.90f),
                                Color.Transparent,
                            )
                        ),
                        shape = shape,
                    )
                    .padding(horizontal = 22.dp, vertical = 22.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
            ) {
                // 顶上那枚小圆：冰蓝渐变 + 一点星光
                Box(
                    Modifier
                        .size(46.dp)
                        .clip(CircleShape)
                        .background(Brush.verticalGradient(listOf(IceBlueLight, IceBlue))),
                    contentAlignment = Alignment.Center,
                ) {
                    Icon(
                        Icons.Filled.AutoAwesome,
                        contentDescription = null,
                        tint = Color.White,
                        modifier = Modifier.size(22.dp),
                    )
                }

                Spacer(Modifier.height(15.dp))
                Text(
                    "选择使用模式",
                    fontSize = 19.sp,
                    fontWeight = FontWeight.Bold,
                    color = cs.onSurface,
                )
                Spacer(Modifier.height(7.dp))
                Text(
                    "你主要用它做什么？以后随时能在设置里改",
                    fontSize = 12.5.sp,
                    color = cs.onSurfaceVariant,
                    textAlign = TextAlign.Center,
                )

                Spacer(Modifier.height(20.dp))
                ModeOption(
                    icon = Icons.Filled.ShoppingBag,
                    title = "我是买家",
                    sub = "记我约的稿 · 给了谁多少钱",
                    onClick = { lightTick(haptic); onPick(AppMode.BUYER) },
                )
                Spacer(Modifier.height(12.dp))
                ModeOption(
                    icon = Icons.Filled.Palette,
                    title = "我是画师",
                    sub = "记我接的单 · 定金尾款收没收",
                    onClick = { lightTick(haptic); onPick(AppMode.ARTIST) },
                )

                Spacer(Modifier.height(6.dp))
                TextButton(onClick = onLater) {
                    Text("稍后再说", fontSize = 13.sp, color = cs.onSurfaceVariant)
                }
            }
        }
    }
}

/** 弹窗里的一张选项卡：图标 + 一行标题 + 一行小字 + 右边一个箭头 */
@Composable
private fun ModeOption(
    icon: ImageVector,
    title: String,
    sub: String,
    onClick: () -> Unit,
) {
    val cs = MaterialTheme.colorScheme
    val interaction = remember { MutableInteractionSource() }
    val pressed by interaction.collectIsPressedAsState()
    val scale by animateFloatAsState(
        targetValue = if (pressed) 0.97f else 1f,
        animationSpec = spring(dampingRatio = 0.62f, stiffness = 900f),
        label = "optScale",
    )
    val shape = RoundedCornerShape(16.dp)

    Row(
        Modifier
            .fillMaxWidth()
            .graphicsLayer {
                scaleX = scale
                scaleY = scale
            }
            .clip(shape)
            .background(cs.primary.copy(alpha = 0.09f))
            .border(1.dp, cs.primary.copy(alpha = 0.20f), shape)
            .clickable(
                interactionSource = interaction,
                indication = null,
                onClick = onClick,
            )
            .padding(horizontal = 13.dp, vertical = 12.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        Box(
            Modifier
                .size(40.dp)
                .clip(RoundedCornerShape(12.dp))
                .background(cs.primary.copy(alpha = 0.14f)),
            contentAlignment = Alignment.Center,
        ) {
            Icon(icon, contentDescription = null, tint = cs.primary, modifier = Modifier.size(21.dp))
        }
        Spacer(Modifier.width(12.dp))
        Column(Modifier.weight(1f)) {
            Text(title, fontSize = 15.5.sp, fontWeight = FontWeight.SemiBold, color = cs.onSurface)
            Spacer(Modifier.height(2.dp))
            Text(sub, fontSize = 11.5.sp, color = cs.onSurfaceVariant)
        }
        Icon(
            Icons.Filled.ChevronRight,
            contentDescription = null,
            tint = cs.onSurfaceVariant.copy(alpha = 0.50f),
            modifier = Modifier.size(20.dp),
        )
    }
}
