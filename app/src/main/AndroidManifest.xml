<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 2026-10-05 晚加（3.5.29）：开机后要把提醒闹钟重新排上。
         ‼️ 闹钟存在系统的 AlarmManager 里，**手机一重启就全没了**（iOS 是系统帮着记的，没这问题）。
         普通权限，安装即授予，不用问用户。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 2026-10-05 加：截止日提醒要**准点**响（19:00）。
         `setAndAllowWhileIdle` 是「不精确闹钟」，系统给的窗口是 **±1 小时**
         （模拟器实测 dumpsys alarm 里写着 window=+1h0m0s0ms）——
         也就是说 19:00 的提醒可能 19:50 才到，这不叫提醒。
         USE_EXACT_ALARM 是给「闹钟 / 日历」这类 App 用的特殊权限，**安装即授予、用户不能撤**，
         也不需要弹窗；代码里还会用 canScheduleExactAlarms() 兜一道，拿不到就退回不精确的。
         （不上架 Google Play 所以不受它那条政策约束；真上了架要另说。） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 2026-10-05 晚加（安卓 3.5.28）：上面那条 USE_EXACT_ALARM 是「安装即授予」，按理说够用，
         但逸风那台 OPPO（Android 16）实测 —— USE_EXACT_ALARM 明明 granted=true，
         AlarmManager.canScheduleExactAlarms() 仍返回 false → 一路走降级 →
         dumpsys alarm 里那条提醒是 window=+1h0m0s0ms（19:00 的提醒最晚能拖到 20:00）。
         补声明 SCHEDULE_EXACT_ALARM（这条是「用户在设置里可授予」的那个），
         系统设置里才会出现「闹钟和提醒」这一项，App 里那个「去开启」按钮也才有地方跳过去。
         （不上架 Google Play，不受它的精确闹钟政策约束。） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 2026-10-03 加：检查更新。
         ⚠️ 这个 App 在这之前是**没有 INTERNET 权限**的，隐私政策里那句
            「系统层面就没有联网能力」就是靠这个立的旗子。加了它，政策也得改口
            （见 PrivacyScreen.kt / strings.xml 里 privacy_* 那几条）。
         唯一的联网动作 = 读一个几行字的版本号文件，请求里不带任何用户数据。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 下载完新版本要拉起系统安装界面。
         注意这是「特殊权限」，不是普通运行时权限：用户第一次装的时候，
         系统会拦一道「允许安装未知应用」，拒绝就是装不了（App 也做不了手脚）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommissionBook">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.CommissionBook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- 2026-10-05 晚加（3.5.29）：开机 / 覆盖安装之后，把提醒闹钟重新排一遍。
             以前只有「打开 App」会重排 → 手机重启后只要不开 App，提醒就再也不响了。

             ⚠️ 这里必须 exported="true"（跟隔壁 ReminderReceiver 不一样，别照抄那边）：
                这两个 action 都是**系统专用广播**（protected broadcast），只有系统进程发得出来，
                第三方应用根本发不了，所以开着 exported 没有安全风险；
                但写成 false 的话，系统投递时会把它当「未导出接收器」**直接跳过** ——
                2026-10-05 就栽在这上面：注册对、权限对、包也装了，
                dumpsys activity broadcasts 里那条广播却始终「未投递」（dispatchTime 一直空着，永远不派）。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 2026-10-05 晚加（3.5.29）：重启后把提醒闹钟排回来 —— 走 JobScheduler 的持久化任务。
             为什么不靠上面那个开机广播：OPPO 的「启动管理」会把它跳过（日志里 reason: oplus startup），
             唯一解法是让用户开「自启动 + 后台运行 + 关联启动」—— 代价太大，不干。
             JobScheduler 的任务存在系统里，重启由系统自己恢复，**用户一个权限都不用开**。
             上面那个 receiver 留着当双保险（没被厂商拦的机器上它更快）。
             BIND_JOB_SERVICE 权限是 JobService 的硬性要求，少了系统不认这个 service。 -->
        <service
            android:name=".RescheduleJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
