<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 2026-10-05 加：截止日提醒要**准点**响（19:00）。
         `setAndAllowWhileIdle` 是「不精确闹钟」，系统给的窗口是 **±1 小时**
         （模拟器实测 dumpsys alarm 里写着 window=+1h0m0s0ms）——
         也就是说 19:00 的提醒可能 19:50 才到，这不叫提醒。
         USE_EXACT_ALARM 是给「闹钟 / 日历」这类 App 用的特殊权限，**安装即授予、用户不能撤**，
         也不需要弹窗；代码里还会用 canScheduleExactAlarms() 兜一道，拿不到就退回不精确的。
         （不上架 Google Play 所以不受它那条政策约束；真上了架要另说。） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 2026-10-03 加：检查更新。
         ⚠️ 这个 App 在这之前是**没有 INTERNET 权限**的，隐私政策里那句
            「系统层面就没有联网能力」就是靠这个立的旗子。加了它，政策也得改口
            （见 PrivacyScreen.kt / strings.xml 里 privacy_* 那几条）。
         唯一的联网动作 = 读一个几行字的版本号文件，请求里不带任何用户数据。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 下载完新版本要拉起系统安装界面。
         注意这是「特殊权限」，不是普通运行时权限：用户第一次装的时候，
         系统会拦一道「允许安装未知应用」，拒绝就是装不了（App 也做不了手脚）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommissionBook">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.CommissionBook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
