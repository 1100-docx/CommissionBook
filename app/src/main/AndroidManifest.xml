<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 相机（2026-10-07 加，二维码传输）：**只用来扫二维码**，扫完就走 ——
         不拍照、不存照片、不上传。权限本身由 zxing 的扫码界面在用时现场申请，
         但这里必须先声明，不然它连问都不会问。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 没相机的设备照样能装：只有扫码这一个功能需要它，其余照用 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 2026-10-05 加：截止日提醒要**准点**响（19:00）。
         `setAndAllowWhileIdle` 是「不精确闹钟」，系统给的窗口是 **±1 小时**
         （模拟器实测 dumpsys alarm 里写着 window=+1h0m0s0ms）——
         也就是说 19:00 的提醒可能 19:50 才到，这不叫提醒。
         USE_EXACT_ALARM 是给「闹钟 / 日历」这类 App 用的特殊权限，**安装即授予、用户不能撤**，
         也不需要弹窗；代码里还会用 canScheduleExactAlarms() 兜一道，拿不到就退回不精确的。
         （不上架 Google Play 所以不受它那条政策约束；真上了架要另说。） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 2026-10-05 晚加（安卓 3.5.28）：上面那条 USE_EXACT_ALARM 是「安装即授予」，按理说够用，
         但逸风那台 OPPO（Android 16）实测 —— USE_EXACT_ALARM 明明 granted=true，
         AlarmManager.canScheduleExactAlarms() 仍返回 false → 一路走降级 →
         dumpsys alarm 里那条提醒是 window=+1h0m0s0ms（19:00 的提醒最晚能拖到 20:00）。
         补声明 SCHEDULE_EXACT_ALARM（这条是「用户在设置里可授予」的那个），
         系统设置里才会出现「闹钟和提醒」这一项，App 里那个「去开启」按钮也才有地方跳过去。
         （不上架 Google Play，不受它的精确闹钟政策约束。） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 2026-10-03 加：检查更新。
         ⚠️ 这个 App 在这之前是**没有 INTERNET 权限**的，隐私政策里那句
            「系统层面就没有联网能力」就是靠这个立的旗子。加了它，政策也得改口
            （见 PrivacyScreen.kt / strings.xml 里 privacy_* 那几条）。
         唯一的联网动作 = 读一个几行字的版本号文件，请求里不带任何用户数据。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 下载完新版本要拉起系统安装界面。
         注意这是「特殊权限」，不是普通运行时权限：用户第一次装的时候，
         系统会拦一道「允许安装未知应用」，拒绝就是装不了（App 也做不了手脚）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 2026-10-05 晚加（安卓 3.5.35）：请求「允许后台运行」（= 加进电池优化白名单）。
         ‼️ 这是**能一键授权**的那条 —— 系统弹它自己的框，点一下就好。
            「允许自启动」做不到一键（各家 ROM 各写各的，安卓没有标准 API），那个不做。
         不上架 Google Play，不受它的政策限制。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommissionBook">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.CommissionBook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
