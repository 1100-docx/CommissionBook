# 编译产物（不要进仓库，几百 MB）
build/
app/build/
*/build/
.gradle/
.kotlin/
captures/
.cxx/

# 本机路径配置（含本机用户名，换台电脑要自己写）
local.properties

# IDE
.idea/
*.iml
.DS_Store

# 打出来的包（要发就发 GitHub Release，别塞进仓库）
*.apk
*.aab
*.ipa

# ⚠️ 例外（2026-10-03 加）：dist/ 里常驻**最新一版**的 apk。
#    为什么破例：安卓版的「检查更新」需要一个稳定的直链去下安装包，
#    而 GitHub Release 的附件只能用网页或 API 令牌上传（这台机器上两样都没有），
#    所以让仓库里的这个目录充当「更新通道」—— 走 ghfast.top 之类的镜像可直连。
#    规矩：只留最新一份（tools/publish_android.py 会替换旧的并同步 version.json），
#    别在这里堆历史版本。
!dist/*.apk

# 本地版本存档（源码快照 + 安装包，纯本地用；仓库里只留干净的源码）
tools/好的版本备份/

# 多语言替换脚本留下的临时副本（别进仓库）
*.locreplace.bak
